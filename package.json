{
  "name": "@nightnetwork/dusk",
  "version": "1.0.1",
  "description": "Node.js in a browser tab. A complete JavaScript runtime powered by native Web Workers by default, with SpiderMonkey WASI available as an opt-in legacy runtime.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "NightNetwork",
  "maintainers": [
    "NightNetwork"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Night-N3twork/Dusk.git"
  },
  "homepage": "https://github.com/Night-N3twork/Dusk#readme",
  "bugs": {
    "url": "https://github.com/Night-N3twork/Dusk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/duskjs.js"
    }
  },
  "types": "./lib/types/index.d.ts",
  "main": "./lib/duskjs.js",
  "module": "./lib/duskjs.js",
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "ESBUILD-LICENSE.md"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/embed-declaration-map-sources.mjs",
    "prepack": "npm run build:lib",
    "preview": "vite preview",
    "serve": "npm run build && npm run preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/source-boundary.test.mjs && vitest run",
    "verify:release": "npm test && npm run typecheck && node scripts/verify-release.mjs",
    "prepublishOnly": "npm run verify:release"
  },
  "dependencies": {
    "@nightnetwork/dpm": "1.0.0",
    "@nightnetwork/moonbeam": "^1.1.1",
    "@nightnetwork/nova": "^1.1.0"
  },
  "devDependencies": {
    "@babel/standalone": "^8.0.4",
    "@terbiumos/tfs": "^1.0.24",
    "@types/node": "^24.10.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@wasmer/wasi": "^0.12.0",
    "@wasmer/wasmfs": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.10.1",
    "file-type": "^22.0.1",
    "ini": "^7.0.0",
    "isomorphic-git": "^1.44.2",
    "minimatch": "^10.2.6",
    "papaparse": "^5.5.4",
    "playwright": "^1.49.0",
    "pyodide": "^314.0.2",
    "re2js": "^2.8.5",
    "smol-toml": "^1.9.0",
    "sprintf-js": "^1.1.3",
    "systemjs": "^6.15.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
